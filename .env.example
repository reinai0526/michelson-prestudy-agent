DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY_PORT=8787

# 教师后台访问码。部署时务必修改，不要把真实访问码提交到代码仓库。
TEACHER_ACCESS_CODE=请替换为仅教师知道的访问码

# 未配置 Supabase 时会使用服务器本地文件收集，适合本机/校内长期运行。
# 公网托管如需跨重启永久保存，建议执行 server/supabase-schema.sql 后填写下面两项。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 也可以将此路径指向服务器的持久化磁盘。
SUBMISSION_DATA_FILE=./runtime-data/student-submissions.json
